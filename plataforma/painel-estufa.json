      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Temperatura e umidade do ar",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "mysql",
                      "version": "v0",
                      "datasource": {
                        "name": "bg435vbtt6ubke"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "SELECT CAST(recvTime AS DATETIME(3)) AS time,\n       attrName AS metric,\n       CAST(attrValue AS DECIMAL(6,1)) AS value\nFROM estufa\nWHERE attrName IN ('temperature', 'relativeHumidity') AND $__timeFilter(recvTime)\nORDER BY time;"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
